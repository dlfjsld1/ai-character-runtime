# Copy to .env and fill in the paths for components you intend to run.
# The diagnostic command only reads local settings and never downloads models.
LOCAL_ONLY=true
ALLOW_PAID_PROVIDERS=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Omitted selectors use these defaults; only explicitly registered adapters run.
APPRAISAL_PROVIDER=jev
DIALOGUE_PROVIDER=ollama
APPRAISAL_MODEL=jev-1.13.0
# Explicit alternative: APPRAISAL_PROVIDER=openai-decisions-v3
# Opt-in small-praise policy: APPRAISAL_PROVIDER=openai-decisions-v4
# Opt-in pressure/boundary policy (includes v4 praise): APPRAISAL_PROVIDER=openai-decisions-v5
# v4 uses the same gpt-6-luna questions; confirmed praise may add a marked small joy baseline.
# and APPRAISAL_MODEL=gpt-6-luna; uses DIALOGUE_API_KEY and the shared budget.
# Hosted Jev is blocked by default. Approve cost/external synthetic input first.
TYPESAFE_API_KEY=
DIALOGUE_MODEL=qwen2.5:7b
# Adopted alternative: gemma4:12b-it-qat with its matching local tokenizer.
# The installed project selection can be stored in runtime-data/ai-local.json.
# An explicit .env setting overrides that local selection.
DIALOGUE_TOKENIZER_PATH=
OLLAMA_CONTEXT_TOKENS=4096
DATABASE_URL=
# Optional compiled UI directory, e.g. an existing J: build. Empty uses apps/studio/dist.
STUDIO_DIST_PATH=
OMNIVOICE_PYTHON=J:/ai/omnivoice tts/omnivoice-env/Scripts/python.exe
OMNIVOICE_MODEL_PATH=
VOICE_PRESET_ID=
STT_PYTHON=
STT_MODEL_PATH=
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=ko
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# OLLAMA_NO_CLOUD=1 and OLLAMA_NUM_PARALLEL=1 must be set in the
# environment of the separately launched Ollama server, not only here.

# Dedicated project-local DB bootstrap writes private runtime-data/local.env.
# Explicit .env settings take priority. Never point tests at your experience DB.
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
QWEN_TOKENIZER_PATH=
TOKENIZER_PYTHON=
# OpenAI generation comparison is disabled by default; no automatic selection.
DIALOGUE_API_KEY=
DIALOGUE_BUDGET_USD=0
DIALOGUE_BUDGET_PATH=
# Cumulative limits include historical entries in that same ledger, not per start.
# Non-default limits require a record of the user's actual approved scope.
OPENAI_MAX_DECISION_CALLS=36
OPENAI_MAX_DIALOGUE_CALLS=24
OPENAI_BUDGET_AUTHORIZATION=
# Explicit historical unknown acknowledgements retain the full guard reserve.
# Confirm the old physical caller has ended; new unknown/reserved calls block.
OPENAI_ACKNOWLEDGED_COUNT_ENTRY_ID=
OPENAI_ACKNOWLEDGED_DIALOGUE_ENTRY_ID=
