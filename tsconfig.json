{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "evals/**/*.ts",
    "*.config.ts"
  ]
}
